# =================================================================
# Club 602 & QNW Bot Ecosystem — Environment Configuration (.env)
# =================================================================

# GEMINI_API_KEY: Optional runtime AI generation key
GEMINI_API_KEY=""

# APP_URL: Current app hosting URL
APP_URL=""

# -----------------------------------------------------------------
# 1. BOT 1: THE COMMISSIONER (QNW Fantasy Enforcer)
# -----------------------------------------------------------------
COMMISSIONER_TOKEN="your_commissioner_discord_bot_token_here"
COMMISSIONER_CLIENT_ID="your_commissioner_application_client_id_here"

# -----------------------------------------------------------------
# 2. BOT 2: THE LINEMAKER (ChainLink Sportsbook Alerts)
# -----------------------------------------------------------------
LINEMAKER_TOKEN="your_linemaker_discord_bot_token_here"
LINEMAKER_CLIENT_ID="your_linemaker_application_client_id_here"

# -----------------------------------------------------------------
# 3. BOT 3: THE PRODUCER (ScriptLess Reality TV Roster)
# -----------------------------------------------------------------
PRODUCER_TOKEN="your_producer_discord_bot_token_here"
PRODUCER_CLIENT_ID="your_producer_application_client_id_here"

# -----------------------------------------------------------------
# 4. BOT 4: THE CONCIERGE (Club 602 VIP Hospitality)
# -----------------------------------------------------------------
CONCIERGE_TOKEN="your_concierge_discord_bot_token_here"
CONCIERGE_CLIENT_ID="your_concierge_application_client_id_here"

# -----------------------------------------------------------------
# 5. DISCORD GUILD (SERVER) ROUTING
# -----------------------------------------------------------------
# HUB_GUILD_ID: Unified Discord server where Commissioner, Linemaker, and Producer coexist
HUB_GUILD_ID="123456789012345678"

# CLUB602_GUILD_ID: Standalone Discord server where Concierge operates
CLUB602_GUILD_ID="876543210987654321"

# -----------------------------------------------------------------
# 6. FIREBASE & FANTRAX INTEGRATIONS
# -----------------------------------------------------------------
# Path to your Firebase service account JSON key on the Raspberry Pi
FIREBASE_SERVICE_ACCOUNT_PATH="./firebase-service-account.json"

# Fantrax League IDs (comma-separated if multiple leagues are audited)
FANTRAX_LEAGUE_IDS="gridiron_exotics_2026,chop_league_alpha"
